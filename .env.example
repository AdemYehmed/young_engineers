# Copiez ce fichier en .env puis adaptez-le :  cp .env.example .env
# Ne publiez JAMAIS le fichier .env (il est déjà dans .gitignore).

# development (local) ou production (en ligne, HTTPS obligatoire)
YE_ENV=development

# Clé secrète des sessions. En développement, run.sh en génère une automatiquement.
# En production : 32 caractères minimum, générée avec
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Cookies marqués "Secure" (HTTPS uniquement). Obligatoire en production.
SESSION_COOKIE_SECURE=false

# Adresse d'écoute du serveur de développement
YE_HOST=127.0.0.1
YE_PORT=5000

# Emplacements (laissez vide pour utiliser le dossier instance/)
DATABASE_PATH=
UPLOAD_DIR=
BACKUP_DIR=

# Images envoyées depuis l'administration : taille maximale en Mo
MAX_UPLOAD_MB=3

# Limitation des tentatives
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
REGISTER_MAX_PER_HOUR=10

# Derrière nginx/Caddy : nombre de reverse proxys de confiance (0 = aucun)
TRUST_PROXY=0

# Durée de session administrateur (minutes)
ADMIN_SESSION_MINUTES=120

# ---- Déploiement Render + PostgreSQL (voir DEPLOIEMENT.md) ----
# Adresse PostgreSQL (prioritaire sur DATABASE_PATH). Laisser vide en local pour utiliser SQLite.
DATABASE_URL=
# Premier administrateur créé automatiquement SI la table admins est vide (Render gratuit n'a pas de terminal).
# Générer l'empreinte : python create_admin.py --username NOM --print-hash   (jamais le mot de passe en clair)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
# Étape optionnelle de durcissement : secret ajouté par Netlify, exigé par l'application (24+ caractères).
PROXY_SHARED_SECRET=
# En-tête portant l'IP réelle du visiteur ajouté par Netlify (n'est cru qu'avec le secret ci-dessus).
CLIENT_IP_HEADER=
